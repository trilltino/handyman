# Google Places API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable "Places API" in your Google Cloud Console
GOOGLE_PLACES_API_KEY=your_api_key_here

# Search Configuration
SEARCH_LOCATION=Coventry, UK
SEARCH_RADIUS_METERS=16000

# Trade types to search (comma-separated)
TRADE_TYPES=plumber,electrician,handyman,carpenter,roofer,painter,builder
